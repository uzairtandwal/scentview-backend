# Add these lines to your public/.htaccess file, ideally at the very beginning
# or after "RewriteEngine On", but before any specific routing rules.

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, Content-Type, Accept, Authorization, X-Requested-With"
</IfModule>